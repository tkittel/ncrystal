==== Syntax ====
items and loop (both modes):
  data_a @1
    _x: U[1]@2
    _y: U[2.5(3)]@3
    _l1 (loop col 0/2): U[a]@6 U[c]@7
    _l2 (loop col 1/2): U[b]@6 U[d]@7
    _z: U[-1e-3]@8
quoted (both modes):
  data_q @1
    _s1: S[a dog's life]@2
    _s2: D[say "hi"!]@3
    _s3: S[it''s]@4
    _s4: S[]@5
    _s5: D[]@6
    _s6: S[tab after]@7
    _s7: S[x"y]@8
    _s8: D[x'y]@8
    _s9: S[ ]@9
    _s10: S[a'b]@10
backslash (both modes):
  data_b @1
    _x (loop col 0/2): S[an embedded \]@2
    _y (loop col 1/2): U[quote']@2
text fields (both modes):
  data_t @1
    _t1: T[foo]@3
    _t2: T[ foo\n  bar]@6
    _t5: T[ a;b\n x ; y\n ;]@10
    _t6: T[trailing  ]@15
    _t7: T['q' "d" # not a comment]@18
unquoted (both modes):
  data_u @1
    _u1: U[;abc]@2
    _u2: U[a;b]@3
    _u3: U[a'b"c]@4
    _u4: ?[?]@5
    _u5: .[.]@6
    _u6: S[?]@7
    _u7: S[.]@8
    _u8: D[?]@9
    _u9: U[;]@10
    _u10: U[?a]@11
    _u11: U[.5]@12
    _u12: U[a#b]@13
    _u13: U[a_b]@14
    _u14: U[..]@15
reserved (both modes):
  data_r @1
    _r1: U[loop_x]@2
    _r2: U[global_x]@3
    _r3: U[stop_x]@4
    _r4: S[loop_]@5
    _r5: D[data_x]@6
    _r6: U[xdata_]@7
    _r7: S[save_]@8
    _r8: U[dat_]@9
    _r9: T[data_]@11
case (both modes):
  data_Up @1
    _Tag: U[VaLuE]@2
    _L1 (loop col 0/2): U[A]@3
    _l2 (loop col 1/2): U[b]@3
  data_x @4
    _y: U[Z]@4
names (both modes):
  data_a'b"c#d$e;f[g]h_ @1
    _t'a"g#$;[]_: U[1]@2
comments (both modes):
  data_c#x @5
    _a#b: U[1#c]@7
    _b: U[2]@8
    _c: U[3]@11
    _l (loop col 0/1): U[1]@14 U[2]@16 U[3]@18
    _d: S[x'#y]@19
comment after header (both modes):
  data_x @1
    _a: U[1]@2
# in loop values (both modes):
  data_x @1
    _label (loop col 0/2): U[N1T#]@3 U[C#1]@4
    _type (loop col 1/2): U[Cp#2Yb]@3 S[a#b]@4
tabs (both modes):
  data_tab @1
    _a: U[1]@1
    _b (loop col 0/2): U[x]@1
    _c (loop col 1/2): S[y]@1
no final eol (both modes):
  data_e @1
    _a: U[1]@2
    _b: U[last]@3
no final eol quoted (both modes):
  data_e @1
    _a: S[last]@2
no final eol textfield (both modes):
  data_e @1
    _a: T[x]@3
loop at end (both modes):
  data_e @1
    _a (loop col 0/2): U[1]@2 U[3]@2
    _b (loop col 1/2): U[2]@2 U[4]@2
loop at end 2 (both modes):
  data_e @1
    _a (loop col 0/2): U[1]@2 U[3]@2
    _b (loop col 1/2): U[2]@2 U[4]@2
CRLF (both modes):
  data_w @1
    _a: U[1]@2
    _t: T[x\ny]@4
    _b: U[2]@7
CR (both modes):
  data_m @1
    _a: U[1]@2
    _t: T[x\ny]@4
    _b: U[2]@7
mixed (both modes):
  data_x @1
    _a: U[1]@2
    _t: T[x\ny\nz\n]@4
    _b: U[2]@9
    _c: U[3]@10
CR blank lines (both modes):
  data_x @1
    _a: U[1]@4
    _b: U[2]@6
    _c: U[3]@8
blocks (both modes):
  data_1 @1
    _a: U[1]@1
  data_2 @1
    _a: U[2]@1
  data_3 @2
  data_4 @3
    _b: U[x]@3
