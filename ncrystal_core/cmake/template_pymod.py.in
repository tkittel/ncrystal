# This is the _ncrystal_core.info or _ncrystal_core_monolithic.info Python
# module, containing an appropriate wrapper function for exposing
# ncrystal-config as a Python entry-point, and containing information about the
# installation. Several of the strings in this file has content generated by
# CMake.

#Expanded by CMake:
_has_shlib_in_scripts_dir = bool('@ncrystal_pymod_shlib_in_scripts@')

def _ncrystal_config_cli_wrapper():
    import pathlib
    import subprocess
    import sys
    f = pathlib.Path(__file__).parent.joinpath('data','bin','ncrystal-config')
    a = sys.argv[:]
    a[0] = f
    if _has_shlib_in_scripts_dir:
        #Windows, must let the binary ncrystal-config know about the actual
        #shlibpath:
        lp = libpath().parent
        a.append('+')
        a.append(str(lp))
    rv = subprocess.run( a, check = False )
    raise SystemExit(rv.returncode)

def version():
    #Expanded by CMake:
    return '@NCrystal_VERSION@'

def libname():
    #Expanded by CMake:
    return '$<TARGET_FILE_NAME:NCrystal>'#NB: generator expression

def namespace():
    #Expanded by CMake:
    return '@NCRYSTAL_NAMESPACE@'

_cache_libpath = [None]
def libpath():
    if _cache_libpath[0] is None:
        _cache_libpath[0] = _libpath_impl()
    return _cache_libpath[0]

def _find_installed_file_via_record( sitepkgs, filename ):
    #Find the distribution (in the sitepkgs directory) whose RECORD file lists
    #this very module file, and return the location of the file named filename
    #listed in the same RECORD (or None if not found). This works for any
    #installation scheme, including the temporary environments of pip build
    #isolation, and never picks up files of another installation.
    import pathlib
    try:
        import importlib.metadata as ilm
    except ImportError:
        return None
    this_file = pathlib.Path(__file__).absolute().resolve()
    for distinfo in sorted( sitepkgs.glob('*.dist-info') ):
        try:
            files = ilm.Distribution.at( distinfo ).files or []
            paths = [ ( f, pathlib.Path(f.locate()).absolute().resolve() )
                      for f in files ]
        except ( OSError, ValueError ):
            continue
        if not any( p == this_file for _, p in paths ):
            continue
        for f, p in paths:
            if f.name != filename:
                continue
            #"pip install --target DIR" installs into a temporary home scheme
            #and then moves the contents of its site-packages and its other
            #top-level directories (e.g. Scripts) into DIR, leaving RECORD
            #paths like ../../Scripts/NCrystal.dll relative to the temporary
            #site-packages, which might now point to an unrelated file. So
            #first try such paths without the leading "..", i.e. as
            #DIR/Scripts/NCrystal.dll (a location which does not exist in
            #normal installations, where Scripts is not inside site-packages):
            parts = f.parts
            while parts and parts[0] == '..':
                parts = parts[1:]
            if parts and len(parts) < len(f.parts):
                p2 = sitepkgs.joinpath(*parts)
                if p2.is_file():
                    return p2.absolute().resolve()
            if p.is_file():
                return p
    return None

def _libpath_impl():
    import pathlib
    shlib_name = libname()
    if not _has_shlib_in_scripts_dir:
        #Not windows, we have the shared library (.so or .dylib) in the module
        #data dir:
        shlib_dirname = '@ncrystal_pymod_shlib_dirname@' #Expanded by CMake
        return pathlib.Path(__file__).parent.joinpath(
            'data', shlib_dirname, shlib_name
        ).absolute().resolve()

    #Windows. The DLL is in the scripts directory (to be in %PATH%) and we must
    #make sure the search works both for normal installations, in the temporary
    #environments in which pip installs build requirements (for instance needed
    #when building NCrystal plugins), or when the user has provided special
    #target flags to pip.

    #The most reliable way to find it is via the RECORD file of the installed
    #distribution, which lists the exact location of every installed file:
    sitepkgs = pathlib.Path(__file__).absolute().parent.parent
    p = _find_installed_file_via_record( sitepkgs, shlib_name )
    if p is not None:
        return p

    #Otherwise, try to look in the scripts directory belonging to the
    #installation of this module, i.e. PREFIX\Scripts for
    #PREFIX\Lib\site-packages\<module> (or ..\Scripts for
    #..\site-packages\<module> in user installations).
    for p in ( sitepkgs.parent.parent.joinpath('Scripts',shlib_name),
               sitepkgs.parent.joinpath('Scripts',shlib_name) ):
        if p.is_file():
            return p.absolute().resolve()

    #Finally search the schemes. To be safe we also look not only in the default
    #scheme, but also in a few other preferred schemes:
    import sysconfig
    schemes = []

    if hasattr(sysconfig,'get_default_scheme'):
        #py 3.10+
        schemes += [ sysconfig.get_default_scheme() ]
    else:
        #py 3.9 or earlier
        schemes += [ sysconfig._get_default_scheme() ]

    if hasattr(sysconfig,'get_preferred_scheme'):
        #py 3.10+
        for scheme_key in ['prefix','home','user']:
            scheme = sysconfig.get_preferred_scheme(scheme_key)
            if scheme not in schemes:
                schemes.append(scheme)
    else:
        #Tack on everything in py 3.9 or earlier:
        schemes += list( sysconfig.get_scheme_names() )

    for scheme in schemes:
        p = pathlib.Path( sysconfig.get_path('scripts',scheme) )
        p = p.joinpath(shlib_name)
        if p.is_file():
            return p.absolute().resolve()

    #Error:
    ln = libname()
    raise RuntimeError('Unable to locate shared library (expected '
                       f'{ln} in Python site scripts directory)')
